# DeepAgents JS uses LangChain's model adapter to call Qwen.
QWEN_API_KEY=your_qwen_api_key
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Qwen3 thinking mode is incompatible with DeepAgents' forced tool_choice.
# Leave this false for the guide's structured tool calls.
QWEN_ENABLE_THINKING=false

# PostgreSQL connection used for mandatory call auditing.
DATABASE_URL=postgresql://guide_user:change-me@127.0.0.1:5432/ai_experience

# Server and concurrency settings.
PORT=3000
MAX_CONCURRENT_CALLS=12
DB_POOL_MAX=20
