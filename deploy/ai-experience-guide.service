[Unit]
Description=AI Experience Center Guide
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/data/software/guidelines
Environment=NODE_ENV=production
Environment=PORT=3100
ExecStart=/usr/bin/node /data/software/guidelines/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
